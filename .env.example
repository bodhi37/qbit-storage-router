# Copy to your environment / systemd override. Router reads real env vars.
# QBIT_URL=http://127.0.0.1:8080/api/v2
# POLL_SECONDS=0.5
# POOL_ROOT=/mnt/pool
# QBIT_STORAGE_ROUTER_CONFIG=/etc/qbit-storage-router.json
# QBIT_ROUTER_DOWNLOADS=downloads/torrents
# QBIT_ROUTER_INCOMPLETE=downloads/incomplete
# QBIT_ROUTER_ARR_LOCAL_DOWNLOADS=/data/downloads/
# MANAGED_STOP_GRACE=5
# IMPORT_SETTLE_SECONDS=300
# IMPORT_CHECK_INTERVAL=5
# IMPORT_CLEANUP_GRACE_SECONDS=600
# METADATA_DL_LIMIT=524288
# METADATA_CLEANUP_LIMIT=67108864
# ARR_AUDIT_INTERVAL=15
# QBIT_ROUTER_SONARR_CONFIG=/mnt/drive-a/configs/sonarr/config.xml
# QBIT_ROUTER_RADARR_CONFIG=/mnt/drive-a/configs/radarr/config.xml
# QBIT_ROUTER_SONARR_ROOT=/data/media/shows
# QBIT_ROUTER_RADARR_ROOT=/data/media/movies
# Optional second qBittorrent-based download client. Empty = qBittorrent only.
# Set a name to allow one extra client; qBittorrent must stay priority 1.
# QBIT_ROUTER_GATEWAY_NAME=
# QBIT_ROUTER_REQUIRE_GATEWAY=0
# QBIT_ROUTER_QBIT_PORT=8080
# QBIT_ROUTER_GATEWAY_PORT=8283
